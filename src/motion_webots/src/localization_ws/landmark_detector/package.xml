<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>landmark_detector</name>
  <version>0.1.0</version>
  <description>
    YOLOv8n field-landmark detector: training/export/benchmark toolkit plus a
    backend-pluggable ROS2 inference node (pt / onnx / OpenVINO / TensorRT) that
    publishes soccer_msgs/BoundingBoxes. Targets Intel NUC (OpenVINO INT8) and
    Jetson Orin Nano (TensorRT INT8).
  </description>
  <maintainer email="muhammadmiftah13070@gmail.com">Muhammad Miftah</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>soccer_msgs</exec_depend>
  <exec_depend>landmark_geometry</exec_depend>
  <!-- pip (not rosdep): ultralytics, onnx, onnxruntime, openvino;
       TensorRT comes from JetPack on the Orin. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
